---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title={i18n(I18nKey.life)} description={i18n(I18nKey.life)}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<h1 class="text-2xl font-bold text-90">{i18n(I18nKey.life)}</h1>
			<p class="mt-2 text-75">Sports (marathon / swimming / freediving) and music (singing / guitar).</p>
		</div>
	</div>
</MainGridLayout>

